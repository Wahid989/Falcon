# FALCON environment configuration (example).
#
# Copy this file to a git-ignored `.env` in the repository root:
#     cp config/.env.example .env
# Docker Compose reads the root .env automatically. Never commit real secrets;
# full config separation is handled in FALCON-090.

# --- SQL Server --------------------------------------------------------------
# SA password. Must meet complexity: 8+ characters with uppercase, lowercase,
# a digit, and a symbol, or the container refuses to start.
MSSQL_SA_PASSWORD=Falcon_local_dev_1

# --- .NET storage service ----------------------------------------------------
# Connection string the storage-api uses to reach SQL Server. The host
# "sql-server" is the Docker Compose service name.
ConnectionStrings__FalconDb=Server=sql-server,1433;Database=Falcon;User Id=sa;Password=Falcon_local_dev_1;TrustServerCertificate=True
