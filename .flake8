[flake8]
# Match black's line length and defer wrapping decisions to black.
max-line-length = 88
# E203 (whitespace before ':') and W503 (line break before binary operator)
# conflict with black's formatting; ignore them.
extend-ignore = E203, W503
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist
